        "mode": "light",
        "primary.main": "#DB036B",
        "primary.contrastText": "#FFFFFF",
        "secondary.main": "#190609",
        "background.default": "#F9F5F6",
        "background.paper": "#FFFFFF",
        "text.primary": "#190609",
        "text.secondary": "#70484D",
