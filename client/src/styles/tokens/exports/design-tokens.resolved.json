    },
    "custom": {
      "appBar": {
        "shadow": "0 1px 4px #1906090F"
      },
      "card": {
        "bg": "#FFFFFF",
        "radius": 16,
        "shadow": "0 2px 8px #0000000A"
      },
      "chip": {
        "bg": "#F1E9EA"
      },
      "badge": {
        "surface": "#F5EEDC",
        "radius": 4,
        "fontFamily": "IBM Plex Sans, Noto Serif TC, PingFang HK, PingFang TC, Microsoft JhengHei, sans-serif"
      },
      "navItem": {
        "selectedBg": "#190609",
        "selectedColor": "#FFFFFF"
      },
      "dynamicCardPalette": [
        "#3C3029",
        "#213329",
        "#202538",
        "#3B2B35",
        "#2A3B40"
      ],
      "markdown": {
